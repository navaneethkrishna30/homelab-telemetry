# Copy to .env and fill in. .env is git-ignored.
GRAFANA_ADMIN_PASSWORD=change-me
# Name for this machine in the host_name label (metrics + journald logs)
HOST_NAME=myhost
# Optional: Immich admin API key (Account Settings > API Keys). Enables storage, usage and job-queue metrics.
IMMICH_API_KEY=
# Optional: Immich base URL as seen from the telemetry bridge network
IMMICH_URL=http://172.30.0.1:2283
# Public-to-the-tailnet URL of Grafana (tailscale serve --https=3443)
GRAFANA_ROOT_URL=https://myhost.my-tailnet.ts.net:3443
# Optional: an OpenWrt router running node_exporter (Lua) as CGI, and where its syslog arrives
OPENWRT_ADDR=192.168.1.1:9100
OPENWRT_NAME=router
SYSLOG_BIND=192.168.1.10
