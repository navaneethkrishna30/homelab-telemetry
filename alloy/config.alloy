// Hub collector. Single ingress for the tailnet: OTLP/HTTP on :4318
// (exposed via `tailscale serve`). Also scrapes local node_exporter and reads
// the local systemd journal.
//
// Label convention used everywhere (metrics + logs + traces):
//   host_name               which machine
//   deployment_environment  homelab (room to grow: prod/dev)
//   service_name            claude-code, claude-rc, node, immich, ...
// i.e. the OTel resource attributes host.name / deployment.environment /
// service.name, with dots turned into underscores by Prometheus and Loki.

// ---------------------------------------------------------------- OTLP in
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.processor.transform.defaults.input]
    logs    = [otelcol.processor.transform.defaults.input]
    traces  = [otelcol.processor.transform.defaults.input]
  }
}

// Anything arriving without host/env gets an explicit "unknown" so it is
// visible in dashboards instead of silently unlabelled.
otelcol.processor.transform "defaults" {
  error_mode = "ignore"
  metric_statements {
    context    = "resource"
    statements = [
      `set(attributes["host.name"], "unknown") where attributes["host.name"] == nil`,
      `set(attributes["deployment.environment"], "homelab") where attributes["deployment.environment"] == nil`,
    ]
  }
  log_statements {
    context    = "resource"
    statements = [
      `set(attributes["host.name"], "unknown") where attributes["host.name"] == nil`,
      `set(attributes["deployment.environment"], "homelab") where attributes["deployment.environment"] == nil`,
    ]
  }
  trace_statements {
    context    = "resource"
    statements = [
      `set(attributes["host.name"], "unknown") where attributes["host.name"] == nil`,
      `set(attributes["deployment.environment"], "homelab") where attributes["deployment.environment"] == nil`,
    ]
  }
  output {
    metrics = [otelcol.processor.deltatocumulative.default.input]
    logs    = [otelcol.processor.batch.default.input]
    traces  = [otelcol.processor.batch.default.input]
  }
}

// Claude Code exports delta temporality by default; Prometheus wants cumulative.
otelcol.processor.deltatocumulative "default" {
  output {
    metrics = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.otlphttp.loki.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

// ------------------------------------------------------------ backends out
otelcol.exporter.prometheus "default" {
  resource_to_telemetry_conversion = true
  forward_to                       = [prometheus.remote_write.prom.receiver]
}

prometheus.remote_write "prom" {
  endpoint {
    url = "http://prometheus:9090/api/v1/write"
  }
}

otelcol.exporter.otlphttp "loki" {
  client {
    endpoint = "http://loki:3100/otlp"
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo:4317"
    tls {
      insecure = true
    }
  }
}

// ------------------------------------------------- local node_exporter
prometheus.scrape "node" {
  targets = [{
    __address__ = "172.30.0.1:9100",
    job         = "node",
    instance    = sys.env("HOST_NAME"),
  }]
  // Everything in the homelab is collected every 15s; the Machines page refreshes at the same rate.
  scrape_interval = "15s"
  scrape_timeout  = "10s"  // must not exceed the interval
  forward_to      = [prometheus.relabel.local.receiver]
}

// Intel iGPU (intel-gpu-exporter samples every 5s itself; we keep every third).
prometheus.scrape "igpu" {
  targets = [{
    __address__ = "intel-gpu-exporter:9102",
    job         = "intel-gpu",
    instance    = sys.env("HOST_NAME"),
  }]
  scrape_interval = "15s"
  scrape_timeout  = "10s"
  forward_to      = [prometheus.relabel.local.receiver]
}

prometheus.relabel "local" {
  rule {
    target_label = "host_name"
    replacement  = sys.env("HOST_NAME")
  }
  rule {
    target_label = "deployment_environment"
    replacement  = "homelab"
  }
  forward_to = [prometheus.remote_write.prom.receiver]
}

// ------------------------------------------------------ OpenWrt router
// node_exporter (Lua) on the router, served as CGI at /cgi-bin/metrics (see the router's install script).
// OPENWRT_ADDR / OPENWRT_NAME in .env; if no router answers, its `up` series is simply 0.
prometheus.scrape "openwrt" {
  targets = [{
    __address__ = coalesce(sys.env("OPENWRT_ADDR"), "192.168.1.1:9100"),
    job         = "openwrt",
    instance    = coalesce(sys.env("OPENWRT_NAME"), "router"),
  }]
  metrics_path    = "/cgi-bin/metrics"
  scrape_interval = "15s"
  scrape_timeout  = "10s"   // a full scrape takes ~1.5 s on a MIPS router
  forward_to      = [prometheus.relabel.openwrt.receiver]
}

prometheus.relabel "openwrt" {
  rule {
    target_label = "host_name"
    replacement  = coalesce(sys.env("OPENWRT_NAME"), "router")
  }
  rule {
    target_label = "deployment_environment"
    replacement  = "homelab"
  }
  forward_to = [prometheus.remote_write.prom.receiver]
}

// The router's syslog (logd: kernel, dnsmasq, hostapd, firewall, tailscaled, ...) over UDP.
// On the router: uci set system.@system[0].log_ip=<this host> log_port=5514 log_proto=udp
loki.source.syslog "openwrt" {
  listener {
    address       = "0.0.0.0:5514"
    protocol      = "udp"
    syslog_format = "rfc3164"
    labels        = { source = "syslog" }
  }
  relabel_rules = loki.relabel.syslog.rules
  forward_to    = [loki.write.local.receiver]
}

loki.relabel "syslog" {
  forward_to = []
  rule {
    target_label = "host_name"
    replacement  = coalesce(sys.env("OPENWRT_NAME"), "router")
  }
  rule {
    target_label = "deployment_environment"
    replacement  = "homelab"
  }
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "(emergency|alert|critical|error)"
    replacement   = "error"
    target_label  = "level"
  }
  rule {
    source_labels = ["__syslog_message_severity"]
    regex         = "(warning|notice|informational|debug)"
    target_label  = "level"
  }
}

// ------------------------------------------------------ local journald
// Covers system units, user units (claude-rc) and podman/docker containers
// that log to journald (CONTAINER_NAME).
loki.relabel "journal" {
  forward_to = []

  // defaults, overridden by the more specific rules below
  rule {
    target_label = "service_name"
    replacement  = "system"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)\\.service"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__journal__systemd_user_unit"]
    regex         = "(.+)\\.service"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__journal_container_name"]
    regex         = "(.+)"
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__journal__systemd_unit"]
    regex         = "(.+)"
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__systemd_user_unit"]
    regex         = "(.+)"
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }

  // Whitelist: only these services reach Loki, everything else in the journal is dropped.
  // Add a name here (anchored regex on service_name) to start capturing it.
  rule {
    source_labels = ["service_name"]
    regex         = "immich.*|claude-code|cortex.*|searxng|tailscaled|sshd|firewalld|smartd|telemetry-.*"
    action        = "keep"
  }
}

loki.source.journal "local" {
  max_age       = "12h"
  relabel_rules = loki.relabel.journal.rules
  labels = {
    host_name              = sys.env("HOST_NAME"),
    deployment_environment = "homelab",
    source                 = "journal",
  }
  forward_to = [loki.process.journal.receiver]
}

// The stack's own containers: keep warn/error lines only. Loki's "negative structured metadata
// bytes" error fires on every journald push (size=0, harmless) and would feed back into itself.
loki.process "journal" {
  stage.match {
    selector = `{service_name=~"telemetry-.*"} !~ "level=(warn|error|fatal)"`
    action   = "drop"
  }
  stage.match {
    selector = `{service_name="telemetry-loki-1"} |= "negative structured metadata bytes"`
    action   = "drop"
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
