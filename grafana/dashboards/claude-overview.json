  {
   "type": "stat",
   "title": "Sessions (24h)",
   "description": "Distinct sessions with at least one prompt in the last 24h (ignores the time picker).",
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "targets": [
    {
     "datasource": {
      "type": "loki",
      "uid": "loki"
     },
     "expr": "count(sum by (session_id)(count_over_time({service_name=\"claude-code\", host_name=~\"$host\"} | event_name=\"user_prompt\" [24h])))",
     "legendFormat": "",
     "refId": "A",
     "queryType": "instant",
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "auto"
   },
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
