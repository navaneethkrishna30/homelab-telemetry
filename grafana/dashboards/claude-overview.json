 "tags": [
  "claude-code"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "timezone": "browser",
 "time": {
  "from": "now-6d",
  "to": "now+1d"
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Machine",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "host_name",
     "stream": "{service_name=\"claude-code\"}",
     "type": 1,
     "refId": "host"
    },
    "refresh": 2,
    "includeAll": true,
    "multi": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   }
  ]
 },
