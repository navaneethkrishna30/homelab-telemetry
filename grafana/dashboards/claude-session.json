{
 "uid": "claude-session",
 "title": "Claude Code - Session",
 "tags": [
  "claude-code"
 ],
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "1m",
 "timezone": "browser",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "host",
    "label": "Machine",
    "type": "query",
    "datasource": {
     "type": "loki",
     "uid": "loki"
    },
    "query": {
     "label": "host_name",
     "stream": "{service_name=\"claude-code\"}",
     "type": 1,
     "refId": "host"
    },
    "refresh": 2,
    "includeAll": false,
    "multi": false,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "session",
    "label": "Session",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "prometheus"
    },
    "query": {
     "query": "label_values(claude_code_cost_usage_USD_total{host_name=~\"$host\"}, session_id)",
     "refId": "session"
    },
    "definition": "label_values(claude_code_cost_usage_USD_total{host_name=~\"$host\"}, session_id)",
    "refresh": 2,
    "sort": 0,
    "includeAll": false,
    "multi": false
   },
   {
    "name": "qsrc",
    "label": "Query source (regex)",
    "type": "textbox",
    "query": ".*",
    "current": {
     "text": ".*",
     "value": ".*"
    },
    "options": []
   }
  ]
 },
