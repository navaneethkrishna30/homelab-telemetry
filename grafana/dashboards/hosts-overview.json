{
  "uid": "hosts-overview",
  "title": "Hosts",
  "description": "Headline numbers for every machine, from the host:* recording rules.",
  "tags": [
    "hosts"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(host:online, host_name)",
          "refId": "host"
        },
        "definition": "label_values(host:online, host_name)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "links": [
    {
      "title": "Host details",
      "type": "dashboards",
      "tags": [
        "host"
      ],
      "asDropdown": true
    },
    {
      "title": "Node Exporter Full",
      "type": "link",
      "url": "/d/node-exporter-full"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "$host",
      "collapsed": false,
      "panels": [],
      "repeat": "host",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Status",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "host:online{host_name=\"$host\"}",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ONLINE",
                  "color": "green",
                  "index": 0
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OFFLINE",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "background_solid",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "justifyMode": "center"
      },
      "links": [
        {
          "title": "Open ${host} details",
          "url": "/d/host-${host}"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 3,
        "h": 4
      }
    },
