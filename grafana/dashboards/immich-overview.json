     "reducer": [
      "sum"
     ],
     "fields": ""
    }
   },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "job": true,
       "instance": true,
       "host_name": true,
       "deployment_environment": true
      },
      "renameByName": {
