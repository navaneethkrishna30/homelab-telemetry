  {
   "type": "stat",
   "title": "Server",
   "description": "Immich API answers /api/server/ping from the telemetry network.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "max(immich_up{service_name=\"immich\"})",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "editorMode": "code"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "noValue": "0",
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
