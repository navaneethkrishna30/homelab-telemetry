  {
   "type": "table",
   "title": "Backup history",
   "description": "Every finished backup run in the log, newest first.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "immich_backup_run_duration_seconds",
     "legendFormat": "",
     "refId": "A",
     "instant": true,
     "range": false,
     "editorMode": "code",
     "format": "table"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "filterable": true
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Duration"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       },
       {
        "id": "decimals",
        "value": 0
       }
      ]
     }
    ]
   },
   "options": {
